{
  "name": "bendrucker.me",
  "type": "module",
  "version": "1.0.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "astro dev",
    "dev:json": "ASTRO_LOG_JSON=1 astro dev",
    "build": "npm run build:packages && npm run types:generate && astro check && CLOUDFLARE_VITE_FORCE_LOCAL=true astro build",
    "build:packages": "tsc --build packages/logger/tsconfig.json --force",
    "preview": "astro preview",
    "sync": "astro sync",
    "astro": "astro",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "oxlint && eslint .",
    "lint:types": "oxlint --type-aware",
    "types:generate": "wrangler types && prettier --write worker-configuration.d.ts",
    "test": "vitest run",
    "generate:favicons": "tsx scripts/generate-favicons.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.2",
    "@astrojs/markdown-remark": "7.3.0",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@cf-wasm/resvg": "^0.4.0",
    "@cf-wasm/satori": "^0.4.2",
    "@date-fns/tz": "^1.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.5.1",
    "astro": "7.3.5",
    "date-fns": "^4.4.0",
    "lodash.kebabcase": "^4.1.1",
    "remark-collapse": "^0.1.2",
    "remark-toc": "^9.0.0",
    "shiki": "^4.4.2",
    "tailwindcss": "^4.3.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@shikijs/transformers": "^4.4.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/lodash.kebabcase": "^4.1.9",
    "@types/opentype.js": "^1.3.10",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-oxlint": "^1.85.0",
    "opentype.js": "^2.0.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2002",
    "png-to-ico": "^3.0.2",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.142.0"
  },
  "overrides": {
    "zod": "$zod",
    "qs": "6.15.0",
    "lodash": "4.17.23",
    "tmp": "0.2.5",
    "@cloudflare/vite-plugin": {
      "vite": "^8.0.13"
    }
  }
}
